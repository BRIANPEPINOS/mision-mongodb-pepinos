use('bestiario')
db.guardianes.drop()

db.createCollection('guardianes', {
    validator: {
        $jsonSchema: {
            bsonType: 'object',
            required: ["nombre", "rango", "password_acceso", "inventario"],
            properties: {
                nombre: {
                    bsonType: 'string'
                },
                rango: {
                    enum: ["Aprendiz", "Maestro", "Gran Maestro"]
                },
                password_acceso: {
                    bsonType: 'string',
                    pattern: '^(?=.*[A-Z])(?=.*\\d).{8,}$',
                    description: 'Debe tener al menos 8 caracteres, una letra mayúscula y un número'
                },
                nivel: {
                    anyOf: [{ bsonType: 'int' }, { bsonType: 'long' }],
                    minimum: 1,
                    maximum: 99
                },
                inventario: {
                    bsonType: 'array',
                    items: {
                        bsonType: 'object',
                        required: ['nombre_item', 'cantidad'],
                        properties: {
                            nombre_item: {
                                bsonType: 'string'
                            },
                            cantidad: {
                                anyOf: [{ bsonType: 'int' }, { bsonType: 'long' }],
                                minimum: 1
                            }

                        }


                    }
                }
            }
        }

    }
});